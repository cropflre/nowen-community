{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nowen-community",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nowen-community-db",
      "database_id": "REPLACE_WITH_NEW_D1_ID",
      "migrations_dir": "drizzle"
    }
  ]
}